APP_NAME="Personal AI Knowledge Assistant"
APP_ENV=local
API_PREFIX=/api

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_ai
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_HEALTH_STATEMENT_TIMEOUT_SECONDS=2
DATABASE_RETRY_AFTER_SECONDS=5

DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
RUNTIME_SETTINGS_ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
# This placeholder is accepted only for local/test. Generate a unique secret of
# at least 32 bytes before setting APP_ENV to any deployed environment.
AUTH_SECRET_KEY=change-me-in-production-use-at-least-32-bytes
AUTH_TOKEN_ISSUER=personal-ai-backend
AUTH_TOKEN_AUDIENCE=personal-ai-client
AUTH_TOKEN_CLOCK_SKEW_SECONDS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10
# Defaults to true in local/test and false in other environments when omitted.
# AUTH_REGISTRATION_ENABLED=false
# Defaults to false in local/test and true in other environments when omitted.
# AUTH_REGISTRATION_INVITE_REQUIRED=true
# Valid range: 1 minute to 30 days (43200 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Shared PostgreSQL login throttling. The account and ASGI client address are
# HMAC-hashed before storage; raw email/IP values are never persisted.
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_CLIENT_MAX_FAILURES=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
# Must cover both the window and lockout; valid range is up to 7 days.
AUTH_LOGIN_ATTEMPT_RETENTION_SECONDS=86400
# Shared client quota for registration. The first 5 requests per hour are
# allowed; request 6 is blocked before Argon2 work or user lookup.
AUTH_REGISTRATION_CLIENT_MAX_ATTEMPTS=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REGISTRATION_LOCKOUT_SECONDS=3600
AUTH_REGISTRATION_ATTEMPT_RETENTION_SECONDS=86400

# Use local_extractive for local development without an external API key.
# Use openai_compatible when LLM_API_KEY is configured.
LLM_PROVIDER=local_extractive
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Shared wire/decoded JSON response limit for LLM, Embedding, OCR and speech.
AI_PROVIDER_MAX_RESPONSE_SIZE_BYTES=8388608
# Process-local shared concurrency limit for all openai_compatible calls.
AI_PROVIDER_MAX_CONCURRENT_REQUESTS=8
# Per-user shared quota for /chat/query and /organize/* (first N allowed).
AI_USER_MAX_REQUESTS=30
AI_USER_WINDOW_SECONDS=60
AI_USER_LOCKOUT_SECONDS=60
AI_USER_ATTEMPT_RETENTION_SECONDS=86400

# Use local_hash for local development without an external API key.
# Use openai_compatible when EMBEDDING_API_KEY is configured.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
HNSW_EF_SEARCH=100
HNSW_MAX_SCAN_TUPLES=20000

STORAGE_BACKEND=local
STORAGE_ROOT=storage_data
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true
S3_KEY_PREFIX=documents
MAX_UPLOAD_SIZE_BYTES=26214400
# Must be at least MAX_UPLOAD_SIZE_BYTES + 65536 for multipart metadata.
MAX_REQUEST_BODY_SIZE_BYTES=31457280
STORAGE_AUDIT_BATCH_SIZE=500
STORAGE_AUDIT_SAMPLE_LIMIT=100
STORAGE_DELETION_INTERVAL_SECONDS=60
STORAGE_DELETION_BATCH_SIZE=50
STORAGE_DELETION_LEASE_SECONDS=300
STORAGE_DELETION_RETRY_BASE_SECONDS=30
STORAGE_DELETION_RETRY_MAX_SECONDS=3600
STORAGE_DELETION_STATEMENT_TIMEOUT_SECONDS=30
STORAGE_DELETION_SHUTDOWN_TIMEOUT_SECONDS=30
STALE_JOB_AFTER_MINUTES=15
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_RECOVERY_INTERVAL_SECONDS=60
JOB_RECOVERY_BATCH_SIZE=50
JOB_RECOVERY_MAX_ACTIVE_WORKERS=50
JOB_RECOVERY_SCAN_STALE_AFTER_SECONDS=30
JOB_RECOVERY_STATEMENT_TIMEOUT_SECONDS=30
JOB_RECOVERY_SHUTDOWN_TIMEOUT_SECONDS=30
JOB_RETENTION_DAYS=30
MAINTENANCE_CLEANUP_BATCH_SIZE=1000

# Image/audio ingestion providers. Uploads are accepted while disabled, but the
# processing job will fail clearly until openai_compatible is configured.
OCR_PROVIDER=disabled
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini
SPEECH_TO_TEXT_PROVIDER=disabled
SPEECH_TO_TEXT_BASE_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1

# Model rerank (optional). "disabled" falls back to the built-in heuristic reranker.
# "cohere" works with Cohere and Jina-style /rerank APIs.
RERANK_PROVIDER=disabled
RERANK_BASE_URL=https://api.cohere.com/v1
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5

# Observability: Prometheus metrics at /api/metrics, structured JSON logs.
METRICS_ENABLED=true
LOG_FORMAT=text
